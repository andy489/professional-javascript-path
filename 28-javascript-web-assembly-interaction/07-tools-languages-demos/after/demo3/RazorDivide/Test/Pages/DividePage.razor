@page "/divide"

<PageTitle>Divide</PageTitle>

<h1>Divide</h1>
<InputNumber @bind-Value="@Numerator"  />
<InputNumber @bind-Value="@Denominator" />

<p role="status">Result: @Result</p>

<button class="btn btn-Denominator" @onclick="FormDivide">Divide</button>

@code {
    [Parameter]
    public int Numerator { get; set; }
    [Parameter]
    public int Denominator { get; set; }
    public int Result { get; set; }

    public void FormDivide()
    {
        Result = Divide(Numerator, Denominator);
    }

    public int Divide(int num1, int num2)
    {
        if (num2 == 0)
        {
            throw new DivideByZeroException();
        }
        return num1 / num2;
    }
}

